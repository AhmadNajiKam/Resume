<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ personal.name }} — Resume</title>

  <style>
    /*
     * Keep the document intentionally simple:
     * - single column
     * - normal text flow
     * - no CSS grid
     * - no layout tables
     * - no icons
     * - no absolute positioning
     */

    @page {
      size: A4;
      margin: 14mm 16mm;
    }

    * {
      box-sizing: border-box;
      font-weight: 600;
    }

    html {
      font-size: 10pt;
    }

    body {
      margin: 0 auto;
      max-width: 210mm;

      font-family:
        Arial,
        Helvetica,
        sans-serif;

      line-height: 1.3;
      color: #111;
      background: white;
    }

    /* ---------- Header ---------- */

    header {
      text-align: center;
      margin-bottom: 12px;
    }

    h1 {
      margin: 0 0 4px;

      font-size: 22pt;
      font-weight: 700;
      line-height: 1.1;
    }

    .contact {
      margin: 0;
      font-size: 9.5pt;
    }

    .contact a {
      color: inherit;
      text-decoration: none;
    }

    .separator::before {
      content: " | ";
    }

    /* ---------- Sections ---------- */

    section {
      margin-top: 12px;
    }

    h2 {
      margin: 0 0 7px;

      font-size: 11.5pt;
      font-weight: 700;
      text-transform: uppercase;

      border-bottom: 1px solid #222;
      padding-bottom: 2px;
    }

    /* ---------- Entries ---------- */

    .entry {
      margin-bottom: 9px;

      /* Avoid splitting a short entry across two pages. */
      break-inside: avoid;
    }

    .entry:last-child {
      margin-bottom: 0;
    }

    .entry-header,
    .entry-subheader {
      display: flex;
      justify-content: space-between;
      gap: 16px;
    }

    .entry-header {
      font-weight: 700;
    }

    .entry-subheader {
      margin-top: 1px;
      font-size: 9.5pt;
    }

    .location,
    .date {
      white-space: nowrap;
      text-align: right;
    }

    /* ---------- Bullets ---------- */

    ul {
      margin: 4px 0 0;
      padding-left: 18px;
    }

    li {
      margin-bottom: 2px;
    }

    /* ---------- Projects ---------- */

    .project-description {
      margin: 2px 0 0;
    }

    /* ---------- Skills ---------- */

    .skill-row {
      margin: 2px 0;
    }

    .skill-label {
      font-weight: 700;
    }

    /* ---------- Print ---------- */

    @media print {
      body {
        max-width: none;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    }
  </style>
</head>

<body>

  <!-- =========================================================
       HEADER
       ========================================================= -->

  <header>
    <h1>{{ personal.name }}</h1>

    <p class="contact">
      <a href="mailto:{{ personal.email }}">
        {{ personal.email }}
      </a>

      {% if personal.phone %}
      <span class="separator"></span>
      <span>{{ personal.phone }}</span>
      {% endif %}

      {% if personal.linkedin %}
      <span class="separator"></span>
      <a href="https://{{ personal.linkedin }}">
        {{ personal.linkedin }}
      </a>
      {% endif %}

      {% if personal.github %}
      <span class="separator"></span>
      <a href="https://{{ personal.github }}">
        {{ personal.github }}
      </a>
      {% endif %}
    </p>
  </header>


  <!-- =========================================================
       EDUCATION
       ========================================================= -->

  {% if education %}
  <section>
    <h2>Education</h2>

    {% for item in education %}
    <article class="entry">

      <div class="entry-header">
        <span>{{ item.institution }}</span>

        {% if item.location %}
        <span class="location">{{ item.location }}</span>
        {% endif %}
      </div>

      <div class="entry-subheader">
        <span>
          {{ item.degree }}

          {% if item.gpa %}
          — GPA: {{ item.gpa.value }}/{{ item.gpa.scale }}
          {% endif %}
        </span>

        {% if item.graduation %}
        <span class="date">{{ item.graduation }}</span>
        {% endif %}
      </div>

      {% if item.achievements %}
      <ul>
        {% for achievement in item.achievements %}
        <li>{{ achievement }}</li>
        {% endfor %}
      </ul>
      {% endif %}

    </article>
    {% endfor %}
  </section>
  {% endif %}



  <!-- =========================================================
       EXPERIENCE
       ========================================================= -->

  {% if experience %}
  <section>
    <h2>Experience</h2>

    {% for job in experience %}
    <article class="entry">

      <div class="entry-header">
        <span>{{ job.company }}</span>

        {% if job.location %}
        <span class="location">{{ job.location }}</span>
        {% endif %}
      </div>

      <div class="entry-subheader">
        <span>{{ job.role }}</span>

        <span class="date">
          {{ job.start }} – {{ job.end }}
        </span>
      </div>

      {% if job.bullets %}
      <ul>
        {% for bullet in job.bullets %}
        <li>{{ bullet }}</li>
        {% endfor %}
      </ul>
      {% endif %}

    </article>
    {% endfor %}
  </section>
  {% endif %}


  <!-- =========================================================
       PROJECTS
       ========================================================= -->

  {% if projects %}
  <section>
    <h2>Projects</h2>

    {% for project in projects %}
    <article class="entry">

      <div class="entry-header">
        <span>{{ project.name }}</span>
      </div>

      {% if project.description %}
      <ul>
        {% for description in project.description %}
        <li>{{ description }}</li>
        {% endfor %}
      </ul>
      {% endif %}

    </article>
    {% endfor %}
  </section>
  {% endif %}


  <!-- =========================================================
       TECHNICAL SKILLS
       ========================================================= -->

  {% if skills %}
  <section>
    <h2>Technical Skills</h2>

    {% if skills.languages %}
    <p class="skill-row">
      <span class="skill-label">Languages:</span>
      {{ skills.languages | join(", ") }}
    </p>
    {% endif %}

    {% if skills.frameworks %}
    <p class="skill-row">
      <span class="skill-label">Frameworks:</span>
      {{ skills.frameworks | join(", ") }}
    </p>
    {% endif %}

    {% if skills.tools %}
    <p class="skill-row">
      <span class="skill-label">Tools:</span>
      {{ skills.tools | join(", ") }}
    </p>
    {% endif %}

    {% if skills.concepts %}
    <p class="skill-row">
      <span class="skill-label">Concepts:</span>
      {{ skills.concepts | join(", ") }}
    </p>
    {% endif %}

  </section>
  {% endif %}


  <!-- =========================================================
       AWARDS
       ========================================================= -->

  {% if awards %}
  <section>
    <h2>Awards &amp; Achievements</h2>

    <ul>
      {% for award in awards %}
      <li>
        <strong>{{ award.achievement }}</strong>
        — {{ award.name }}
        {% if award.organizer %}
        ({{ award.organizer }})
        {% endif %}
      </li>
      {% endfor %}
    </ul>

  </section>
  {% endif %}


  <!-- =========================================================
       CERTIFICATIONS & LANGUAGES
       ========================================================= -->

  {% if certifications or languages %}
  <section>
    <h2>Certifications &amp; Languages</h2>

    {% if certifications %}
    <p class="skill-row">
      <span class="skill-label">Certifications:</span>

      {% for certification in certifications %}
        {{ certification.name }}
        {% if certification.status %}
          ({{ certification.status }})
        {% endif %}
        {% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
    {% endif %}

    {% if languages %}
    <p class="skill-row">
      <span class="skill-label">Languages:</span>

      {% for item in languages %}
        {{ item.language }} ({{ item.proficiency }})
        {% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
    {% endif %}

  </section>
  {% endif %}

</body>
</html>
